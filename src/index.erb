---
layout: default
---
<% meta = site.metadata %>
<% work = site.data.work %>

<section class="hero">
  <h1><span class="hl"><%= meta.headline %></span></h1>
  <div>
    <p class="lede"><%= meta.lede %></p>
    <p class="soft"><%= meta.facts %></p>
    <a class="cta" href="mailto:<%= meta.email %>"><%= meta.cta %></a>
  </div>
</section>

<section>
  <h2><span class="hl">How I can help</span></h2>
  <%= render "audience_cards", groups: site.data.services %>
</section>

<section>
  <h2><span class="hl">Where I've worked</span></h2>
  <ol class="jobs">
    <% work.selected.each do |job| %>
      <li class="job">
        <p class="soft"><%= job.years %></p>
        <h4><%= job.company %></h4>
        <p><%= job.body %></p>
      </li>
    <% end %>
  </ol>
  <p class="soft"><%= work.earlier %></p>
</section>

<section>
  <h2><span class="hl">How I work</span></h2>
  <p class="approach"><%= work.approach %></p>
  <div class="quotes">
    <% work.quotes.each do |quote| %>
      <figure>
        <blockquote>"<%= quote.text %>"</blockquote>
        <figcaption class="soft"><%= quote.who %></figcaption>
      </figure>
    <% end %>
  </div>
</section>

<section>
  <h2><span class="hl">Say hello</span></h2>
  <p><%= work.contact %></p>
  <a class="cta" href="mailto:<%= meta.email %>"><%= meta.cta %></a>
</section>
