<!doctype html>
<html lang="<%= site.locale %>">
  <head>
    <%= render "head", metadata: site.metadata %>
  </head>
  <body>
    <header class="top">
      <a class="name" href="<%= relative_url '/' %>"><%= site.metadata.title %></a>
      <a href="mailto:<%= site.metadata.email %>"><%= site.metadata.email %></a>
    </header>

    <main>
      <%= yield %>
    </main>

    <%= render "footer", metadata: site.metadata %>
  </body>
</html>
