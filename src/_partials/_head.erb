<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= metadata.title %>, <%= metadata.tagline.downcase %> in <%= metadata.location %></title>
<meta name="description" content="<%= metadata.description %>" />

<meta property="og:title" content="<%= metadata.title %>, <%= metadata.tagline.downcase %>" />
<meta property="og:description" content="<%= metadata.description %>" />
<meta property="og:type" content="website" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,200..800&display=swap" />

<link rel="stylesheet" href="<%= asset_path :css %>" />
<script src="<%= asset_path :js %>" defer></script>
<%= live_reload_dev_js %>
